{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.git/**",
      "**/node_modules/**",
      "dejiina_agent/**",
      "scripts/**",
      "**/*.md",
      "**/*.docx",
      "**/*.xlsx",
      "**/*.js",
      "**/*.mjs",
      "**/*.bat",
      "printquote/**",
      "meishi-order/**",
      "meishi-order-kanko/**",
      "stock-portfolio/**",
      "app/**",
      "workers/**",
      "**/.env",
      "**/.env.*",
      "research/**",
      "output/**",
      "33_SNSハーネス/**",
      "開発環境1/**"
    ],
    "redirects": [
      { "source": "/manga",          "destination": "/bibliotheque", "type": 301 }
    ],
    "rewrites": [
      { "source": "/kakeibo",        "destination": "/kakeibo.html" },
      { "source": "/bibliotheque",   "destination": "/manga.html" },
      { "source": "/bucket-list",    "destination": "/bucket-list.html" }
    ],
    "headers": [
      {
        "source": "/manga.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ],
    "cleanUrls": true
  },
  "database": {
    "rules": "database.rules.json"
  }
}
