# StockPortfolio 環境変数テンプレート
# Vercelデプロイ時はダッシュボードで以下の値を設定してください

# PostgreSQL (Neon) 接続文字列
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# JWT署名シークレット（任意の文字列、本番では長くランダムなものを使用）
JWT_SECRET=your-secret-key-here

# ログインパスワード（初回アクセス時のみ使用。DBにハッシュ化して保存され、
# 以降は /settings 画面からアプリ内でパスワードを変更できる）
APP_PASSWORD=your-login-password-here

# Gemini API キー（保有資産スクリーンショットの画像解析に使用。https://aistudio.google.com/apikey で取得）
GEMINI_API_KEY=your-gemini-api-key-here
